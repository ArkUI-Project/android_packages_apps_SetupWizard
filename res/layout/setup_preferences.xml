<org.lineageos.setupwizard.ArkuiSetupLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        style="@style/ArkuiSetupPreferenceFrame">

        <FrameLayout
            android:id="@+id/setup_preferences"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <org.lineageos.setupwizard.NavigationLayout
            android:id="@+id/navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/settingslib_expressive_space_small1"
            android:paddingEnd="@dimen/settingslib_expressive_space_small1" />

    </LinearLayout>
</org.lineageos.setupwizard.ArkuiSetupLayout>
