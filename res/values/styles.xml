<resources xmlns:androidprv="http://schemas.android.com/apk/prv/res/android">
    <style name="Theme.Setup" parent="@style/SudThemeGlifExpressive.DayNight">
        <item name="sucUsePartnerResource">false</item>
        <item name="sudUsePartnerHeavyTheme">false</item>
        <item name="sucFullDynamicColor">false</item>
        <item name="colorAccent">@androidprv:color/materialColorPrimary</item>
        <item name="android:colorAccent">?attr/colorAccent</item>
        <item name="android:windowBackground">@color/arkui_setup_background</item>
        <item name="android:colorBackground">@color/arkui_setup_background</item>
        <item name="android:navigationBarColor">@color/arkui_setup_background</item>
        <item name="colorSurface">@color/arkui_setup_surface</item>
        <item name="colorSurfaceBright">@color/arkui_setup_surface</item>
        <item name="colorSurfaceContainer">@color/arkui_setup_background</item>
        <item name="android:textColorPrimary">@androidprv:color/materialColorOnSurface</item>
        <item name="android:textColorSecondary">@androidprv:color/materialColorOnSurfaceVariant</item>
        <item name="sudBackgroundBaseColor">@color/arkui_setup_background</item>
        <item name="sudBackgroundPatterned">false</item>
        <item name="sudGlifHeaderTitleStyle">@style/ArkuiSetupTitle</item>
        <item name="sudGlifDescriptionStyle">@style/ArkuiSetupDescription</item>
        <item name="sudMarginStart">@dimen/settingslib_expressive_space_small4</item>
        <item name="sudMarginEnd">@dimen/settingslib_expressive_space_small4</item>
        <item name="sudContentFramePaddingTop">16dp</item>
        <item name="sudContentFramePaddingBottom">16dp</item>
        <item name="sudButtonCornerRadius">28dp</item>
        <item name="sucFooterBarButtonMinHeight">56dp</item>
        <item name="alertDialogTheme">@style/Theme.AlertDialog.SettingsLib.Expressive</item>
        <item name="android:alertDialogTheme">@style/Theme.DeviceDefault.AlertDialog.SettingsLib.Expressive</item>
    </style>

    <!-- Headers use 24dp; card content uses one 16dp inset, like Settings. -->
    <style name="ArkuiSetupContentFrame" parent="SudContentFrame">
        <item name="android:paddingLeft">@dimen/settingslib_expressive_space_small1</item>
        <item name="android:paddingRight">@dimen/settingslib_expressive_space_small1</item>
        <item name="android:paddingStart">@dimen/settingslib_expressive_space_small1</item>
        <item name="android:paddingEnd">@dimen/settingslib_expressive_space_small1</item>
    </style>

    <!-- SettingsPreferenceGroupAdapter already provides the card's horizontal inset. -->
    <style name="ArkuiSetupPreferenceFrame" parent="ArkuiSetupContentFrame">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <style name="Theme.Setup.Welcome" parent="Theme.Setup">
        <item name="android:windowBackground">@androidprv:color/materialColorPrimaryContainer</item>
        <item name="android:windowSplashScreenBackground">@androidprv:color/materialColorPrimaryContainer</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Setup.Relay" parent="Theme.Setup">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="ArkuiSetupTitle" parent="SudGlifHeaderTitleExpressive">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="ArkuiSetupDescription" parent="SudGlifDescriptionExpressive">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="LocaleWidget">
        <item name="android:textAppearance">?android:attr/textAppearance</item>
    </style>

    <style name="LocaleWidget.LocalePicker">
        <item name="android:orientation">vertical</item>
        <item name="android:fadingEdge">vertical</item>
        <item name="android:fadingEdgeLength">50dip</item>
    </style>

    <style name="LocaleWidget.Material.LocalePicker" parent="LocaleWidget.LocalePicker">
        <item name="android:background">@drawable/arkui_setup_card</item>
        <item name="solidColor">@android:color/transparent</item>
        <item name="selectionDivider">@drawable/divider</item>
        <item name="selectionDividerHeight">1dip</item>
        <item name="internalLayout">@layout/locale_picker</item>
        <item name="internalMinWidth">64dip</item>
        <item name="internalMaxHeight">180dip</item>
        <item name="virtualButtonPressedDrawable">@null</item>
    </style>

    <style name="NoDisplay" parent="@style/Theme.AppCompat">
        <item name="android:windowBackground">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoDisplay">true</item>
    </style>

    <style name="WelcomeTitle">
        <item name="android:textSize">@dimen/welcome_title_text_size</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:gravity">start</item>
        <item name="android:paddingBottom">@dimen/welcome_title_padding_bottom</item>
        <item name="android:lineHeight">@dimen/welcome_title_line_height</item>
    </style>

    <style name="EdgeToEdgeWallpaperBackground" parent="Theme.Setup">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">?attr/android:windowBackground</item>
        <item name="android:navigationBarColor">?attr/android:windowBackground</item>
    </style>
</resources>
