<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.android.settingslib.widget.IllustrationPreference
        android:key="navigation_illustration"
        android:selectable="false"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false" />

    <PreferenceCategory
        android:key="navigation_modes"
        android:layout="@layout/settingslib_expressive_untitled_preference_category">

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="gesture"
            android:title="@string/gesture_navigation"
            android:persistent="false" />

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="three_button"
            android:title="@string/navbar_navigation"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="navigation_options"
        android:layout="@layout/settingslib_expressive_untitled_preference_category">

        <SwitchPreferenceCompat
            android:key="hide_navigation_hint"
            android:title="@string/hide_gesture_hint"
            android:persistent="false"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
