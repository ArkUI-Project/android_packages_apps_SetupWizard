android_app {
    name: "LineageSetupWizard",

    srcs: ["src/**/*.java"],

    certificate: "platform",
    privileged: true,
    privapp_allowlist: "org.lineageos.setupwizard.xml",
    system_ext_specific: true,
    platform_apis: true,

    overrides: ["Provision"],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    static_libs: [
        "androidx.activity_activity",
        "androidx.dynamicanimation_dynamicanimation",
        "SettingsLib",
        "setupcompat",
        "setupdesign",
        "SystemUISharedLib",
        "org.lineageos.platform.internal",
    ],

    libs: ["telephony-common"],
}

android_test {
    name: "ArkSetupWizardTests",
    srcs: ["tests/src/**/*.java"],
    resource_dirs: [],
    manifest: "tests/AndroidManifest.xml",
    instrumentation_for: "LineageSetupWizard",
    platform_apis: true,
    certificate: "platform",
    static_libs: ["androidx.test.runner", "androidx.test.ext.junit", "junit"],
    test_suites: ["device-tests"],
}
